# Local development only. Copy to .env only when overrides are needed.
POSTGRES_USER=eventlens
POSTGRES_PASSWORD=eventlens-local-only
POSTGRES_DB=eventlens
POSTGRES_PORT=15432
API_PORT=3000
WEB_PORT=4200
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=eventlens-local
MINIO_ROOT_PASSWORD=eventlens-local-storage-only
DATABASE_TIMEOUT_MS=2000

# SMTP Configuration (Brevo u otro proveedor)
# Para probar el envio de correspondencia: node scripts/test-smtp.mjs
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="EventLens Notifications"
SMTP_TEST_RECIPIENT=
