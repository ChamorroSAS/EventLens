# Local development only. Copy to .env only when overrides are needed.
POSTGRES_USER=eventlens
POSTGRES_PASSWORD=eventlens-local-only
POSTGRES_DB=eventlens
POSTGRES_PORT=15432
API_PORT=3000
WEB_PORT=4200
# Origen del frontend para CORS y validacion de Origin de las sesiones. En
# desarrollo con LOCAL_ADMIN_ENABLED=true debe ser loopback o el API no arranca.
WEB_ORIGIN=http://localhost:4200
# Interfaz donde se publica el dev-server. 127.0.0.1 solo permite acceso local;
# 0.0.0.0 lo expone a la LAN para probar los enlaces de invitado desde el celular.
WEB_BIND=127.0.0.1
# Base para los enlaces de invitados y QR. Usa tu URL pública HTTPS al publicar.
PUBLIC_ENTRY_BASE_URL=http://localhost:4200
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=eventlens-local
MINIO_ROOT_PASSWORD=eventlens-local-storage-only
# Receptor de archivos privado para desarrollo (MinIO local, no AWS).
LOCAL_MEDIA_UPLOAD_ENABLED=true
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=eventlens
DATABASE_TIMEOUT_MS=2000

# Optional local admin. Bootstrap generates LOCAL_ADMIN_IDENTIFIER and
# LOCAL_ADMIN_SECRET in the ignored .env; no shared/default password.
LOCAL_ADMIN_ENABLED=false

# SMTP Configuration (Brevo u otro proveedor)
# Para probar el envio de correspondencia: node scripts/test-smtp.mjs
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="EventLens Notifications"
SMTP_TEST_RECIPIENT=
