                    "test:identity":  "pnpm --filter @eventlens/identity test",
                    "build:identity":  "pnpm --filter @eventlens/identity build",
                    "test:media-gallery":  "pnpm --filter @eventlens/media-gallery test",
                    "build:media-gallery":  "pnpm --filter @eventlens/media-gallery build",
