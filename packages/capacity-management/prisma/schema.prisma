datasource db {
  provider = "postgresql"
}

model Plan {
  id                      String   @id @db.Uuid
  code                    String   @unique
  name                    String
  storageBytes            BigInt   @map("storage_bytes")
  maxFiles                Int      @map("max_files")
  maxPhotoBytes           BigInt   @map("max_photo_bytes")
  maxVideoBytes           BigInt   @map("max_video_bytes")
  maxVideoDurationSeconds Int      @map("max_video_duration_seconds")
  retentionDays           Int      @map("retention_days")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignments PlanAssignment[]

  @@map("plan")
}

model PlanAssignment {
  id         String   @id @db.Uuid
  eventId    String   @unique @map("event_id") @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  status     String   @default("ACTIVE")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_assignment")
}

model PlanOverride {
  id            String    @id @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  storageBytes  BigInt?   @map("storage_bytes")
  maxFiles      Int?      @map("max_files")
  retentionDays Int?      @map("retention_days")
  reason        String
  authorizedBy  String    @map("authorized_by")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  removedAt     DateTime? @map("removed_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([eventId, status])
  @@map("plan_override")
}

model CapacityReservation {
  id             String    @id @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  bytes          BigInt    @map("bytes")
  fileSlots      Int       @default(1) @map("file_slots")
  mediaType      String?   @map("media_type")
  status         String    @default("ACTIVE")
  releaseReason  String?   @map("release_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  releasedAt     DateTime? @map("released_at") @db.Timestamptz
  committedAt    DateTime? @map("committed_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([eventId, idempotencyKey])
  @@index([eventId, status])
  @@map("capacity_reservation")
}

model EventCapacityBalance {
  eventId       String   @id @map("event_id") @db.Uuid
  consumedBytes BigInt   @default(0) @map("consumed_bytes")
  consumedFiles Int      @default(0) @map("consumed_files")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("event_capacity_balance")
}
