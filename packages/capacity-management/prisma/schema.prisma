datasource db {
  provider = "postgresql"
}

model Plan {
  id                      String   @id @db.Uuid
  code                    String   @unique
  name                    String
  storageBytes            BigInt   @map("storage_bytes")
  maxFiles                Int      @map("max_files")
  maxPhotoBytes           BigInt   @map("max_photo_bytes")
  maxVideoBytes           BigInt   @map("max_video_bytes")
  maxVideoDurationSeconds Int      @map("max_video_duration_seconds")
  retentionDays           Int      @map("retention_days")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignments PlanAssignment[]

  @@map("plan")
}

model PlanAssignment {
  id         String   @id @db.Uuid
  eventId    String   @unique @map("event_id") @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  status     String   @default("ACTIVE")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_assignment")
}

model PlanOverride {
  id            String    @id @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  storageBytes  BigInt?   @map("storage_bytes")
  maxFiles      Int?      @map("max_files")
  retentionDays Int?      @map("retention_days")
  reason        String
  authorizedBy  String    @map("authorized_by")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  removedAt     DateTime? @map("removed_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([eventId, status])
  @@map("plan_override")
}

model CapacityReservation {
  id             String    @id @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  bytes          BigInt    @map("bytes")
  fileSlots      Int       @default(1) @map("file_slots")
  mediaType      String?   @map("media_type")
  status         String    @default("ACTIVE")
  releaseReason  String?   @map("release_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  releasedAt     DateTime? @map("released_at") @db.Timestamptz
  committedAt    DateTime? @map("committed_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([eventId, idempotencyKey])
  @@index([eventId, status])
  @@map("capacity_reservation")
}

model EventCapacityBalance {
  eventId       String   @id @map("event_id") @db.Uuid
  consumedBytes BigInt   @default(0) @map("consumed_bytes")
  consumedFiles Int      @default(0) @map("consumed_files")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("event_capacity_balance")
}

model MediaConsumptionLedger {
  id            String    @id @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  mediaId       String    @map("media_id") @db.Uuid
  bytes         BigInt    @map("bytes")
  fileSlots     Int       @default(1) @map("file_slots")
  reservationId String?   @map("reservation_id") @db.Uuid
  status        String    @default("COMMITTED")
  committedAt   DateTime  @default(now()) @map("committed_at") @db.Timestamptz
  purgedAt      DateTime? @map("purged_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([eventId, mediaId])
  @@index([eventId, status])
  @@map("media_consumption_ledger")
}

model PurgeReleaseReceipt {
  id             String   @id @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  mediaId        String   @map("media_id") @db.Uuid
  purgeReceiptId String   @map("purge_receipt_id")
  bytes          BigInt   @map("bytes")
  fileSlots      Int      @default(1) @map("file_slots")
  releasedAt     DateTime @default(now()) @map("released_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([eventId, purgeReceiptId])
  @@index([eventId, mediaId])
  @@map("purge_release_receipt")
}

model CapacityThresholdState {
  id              String    @id @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  thresholdType   String    @map("threshold_type")
  status          String    @default("ARMED")
  lastValuePct    Float     @map("last_value_pct")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz
  lastRearmedAt   DateTime? @map("last_rearmed_at") @db.Timestamptz
  dedupKey        String?   @map("dedup_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([eventId, thresholdType])
  @@map("capacity_threshold_state")
}


