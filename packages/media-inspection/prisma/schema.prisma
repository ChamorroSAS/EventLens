generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model Inspection {
 mediaRef String @map("media_ref")
 generation BigInt
 fact Json
 @@id([mediaRef,generation])
 @@map("media_inspection")
}
model PhotoCandidate {
 mediaRef String @map("media_ref")
 generation BigInt
 token String @db.Uuid
 fact Json
 @@id([mediaRef,generation,token])
 @@map("media_photo_candidate")
}
model VideoCandidate {
 mediaRef String @map("media_ref")
 generation BigInt
 token String @db.Uuid
 fact Json
 @@id([mediaRef,generation,token])
 @@map("media_video_candidate")
}
model PromotionReceipt {
 operationId String @id @map("operation_id")
 mediaRef String @map("media_ref")
 generation BigInt
 previousRevision BigInt @map("previous_revision")
 revision BigInt
 jobId String @map("job_id") @db.Uuid
 token String @db.Uuid
 epoch String
 candidateFingerprint String @map("candidate_fingerprint")
 candidate Json
 governance Json
 status String
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_promotion_receipt")
}
model ActiveDerivative {
 mediaRef String @map("media_ref")
 generation BigInt
 role String
 reference Json
 operationId String @map("operation_id")
 @@id([mediaRef,generation,role])
 @@map("media_active_derivative")
}
model PromotionAudit {
 id String @id @db.Uuid
 operationId String @unique @map("operation_id")
 mediaRef String @map("media_ref")
 generation BigInt
 previousRevision BigInt @map("previous_revision")
 revision BigInt
 jobId String @map("job_id") @db.Uuid
 token String @db.Uuid
 epoch String
 governance Json
 transition String
 actor String
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_promotion_audit")
}
model RetryReceipt {
 operationId String @id @map("operation_id")
 mediaRef String @map("media_ref")
 generation BigInt
 jobId String @map("job_id") @db.Uuid
 token String @db.Uuid
 epoch String
 attempt Int
 disposition String
 retryFingerprint String @map("retry_fingerprint")
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_retry_receipt")
}
model RetryAudit {
 id String @id @db.Uuid
 operationId String @unique @map("operation_id")
 mediaRef String @map("media_ref")
 generation BigInt
 jobId String @map("job_id") @db.Uuid
 token String @db.Uuid
 epoch String
 attempt Int
 disposition String
 category String
 sanitizedReason String @map("sanitized_reason")
 retryAt DateTime? @map("retry_at") @db.Timestamptz
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_retry_audit")
}
model TerminalFailureReceipt {
 operationId String @id @map("operation_id")
 mediaRef String @map("media_ref")
 generation BigInt
 previousRevision BigInt @map("previous_revision")
 revision BigInt
 jobId String @map("job_id") @db.Uuid
 token String @db.Uuid
 epoch String
 cause String
 sanitizedReason String @map("sanitized_reason")
 downloadEligible Boolean @map("download_eligible")
 failureFingerprint String @map("failure_fingerprint")
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_terminal_failure_receipt")
}
model TerminalFailureAudit {
 id String @id @db.Uuid
 operationId String @unique @map("operation_id")
 mediaRef String @map("media_ref")
 generation BigInt
 previousRevision BigInt @map("previous_revision")
 revision BigInt
 jobId String @map("job_id") @db.Uuid
 token String @db.Uuid
 epoch String
 cause String
 sanitizedReason String @map("sanitized_reason")
 downloadEligible Boolean @map("download_eligible")
 safetyOutcome String @map("safety_outcome")
 actor String
 transition String
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_terminal_failure_audit")
}
model ProcessingCycle {
 cycleId String @id @map("cycle_id")
 mediaRef String @map("media_ref")
 cycleNumber Int @map("cycle_number")
 eventRef String @map("event_ref")
 organizerRef String @map("organizer_ref")
 jobId String @unique @map("job_id") @db.Uuid
 jobType String @map("job_type")
 safetyOutcome String @map("safety_outcome")
 status String
 operationId String @unique @map("operation_id")
 createdAt DateTime @map("created_at") @db.Timestamptz
 @@unique([mediaRef, cycleNumber])
 @@map("media_processing_cycle")
}
model CycleAudit {
 id String @id @db.Uuid
 operationId String @map("operation_id")
 cycleId String @map("cycle_id")
 mediaRef String @map("media_ref")
 cycleNumber Int @map("cycle_number")
 eventRef String @map("event_ref")
 organizerRef String @map("organizer_ref")
 jobId String @map("job_id") @db.Uuid
 jobType String @map("job_type")
 safetyOutcome String @map("safety_outcome")
 action String
 actor String
 committedAt DateTime @map("committed_at") @db.Timestamptz
 @@map("media_cycle_audit")
}
model CycleDenialAudit {
 id String @id @db.Uuid
 operationId String @map("operation_id")
 mediaRef String @map("media_ref")
 eventRef String @map("event_ref")
 organizerRef String @map("organizer_ref")
 reason String
 actor String
 attemptedAt DateTime @map("attempted_at") @db.Timestamptz
 @@map("media_cycle_denial_audit")
}


