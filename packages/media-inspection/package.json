{
    "name": "@eventlens/media-inspection",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": "./dist/index.js",
    "scripts": {
        "generate": "prisma generate",
        "build": "tsc -p tsconfig.build.json",
