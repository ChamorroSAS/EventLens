        "@prisma/adapter-pg": "7.10.0"
    },
    "devDependencies": {
        "prisma": "7.10.0",
        "typescript": "5.9.3",
        "vitest": "4.0.18",
        "@types/node": "24.10.1",
        "@aws-sdk/client-s3": "3.1148.0"
    }
}
