datasource db {
  provider = "postgresql"
}

model Event {
  id                     String   @id @db.Uuid
  organizerId            String   @map("organizer_id") @db.Uuid
  name                   String
  status                 String   @default("DRAFT")
  timezone               String    @default("America/Bogota")
  startsAtLocal          String?   @map("starts_at_local")
  scheduledAt            DateTime? @map("scheduled_at") @db.Timestamptz
  utcOffsetMinutes       Int?      @map("utc_offset_minutes")
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz
  graceEndsAt            DateTime? @map("grace_ends_at") @db.Timestamptz
  activatedAt            DateTime? @map("activated_at") @db.Timestamptz
  closedAt               DateTime? @map("closed_at") @db.Timestamptz
  purgeStartedAt         DateTime? @map("purge_started_at") @db.Timestamptz
  suspendedAt            DateTime? @map("suspended_at") @db.Timestamptz
  suspensionReason       String?   @map("suspension_reason")
  previousStatus         String?   @map("previous_status")
  validityDurationDays   Int?      @map("validity_duration_days")
  graceDays              Int?      @map("grace_days")
  uploadsEnabled         Boolean   @default(false) @map("uploads_enabled")
  guestGalleryEnabled    Boolean  @default(false) @map("guest_gallery_enabled")
  moderationMode         String   @default("AUTO_PUBLISH") @map("moderation_mode")
  pinEnabled             Boolean  @default(false) @map("pin_enabled")
  pinHash                String?  @map("pin_hash")
  pinSalt                String?  @map("pin_salt")
  idempotencyKey         String?  @unique @map("idempotency_key")
  idempotencyPayloadHash String?  @map("idempotency_payload_hash")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizerId, status])
  @@map("event")
}

model PublicAccessCredential {
  id                     String    @id @db.Uuid
  eventId                String    @map("event_id") @db.Uuid
  lookupKey              String    @unique @map("lookup_key")
  tokenHash              String    @map("token_hash")
  generation             Int       @default(1)
  pinRequired            Boolean   @default(false) @map("pin_required")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz
  idempotencyKey         String?   @unique @map("idempotency_key")
  idempotencyPayloadHash String?   @map("idempotency_payload_hash")

  @@index([eventId, revokedAt])
  @@map("public_access_credential")
}

model GuestSession {
  id                   String    @id @db.Uuid
  eventId              String    @map("event_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  credentialGeneration Int       @default(1) @map("credential_generation")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz
  consentRecordedAt    DateTime? @map("consent_recorded_at") @db.Timestamptz
  consentVersion       String?   @map("consent_version")
  contributorNickname  String?   @map("contributor_nickname")

  @@index([eventId, revokedAt])
  @@map("guest_session")
}

model GuestPinAttempt {
  id            String    @id @db.Uuid
  lookupKey     String    @unique @map("lookup_key")
  attemptCount  Int       @default(1) @map("attempt_count")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  lastAttemptAt DateTime  @default(now()) @map("last_attempt_at") @db.Timestamptz

  @@map("guest_pin_attempt")
}

model GuestConsentRecord {
  id              String   @id @db.Uuid
  guestSessionId  String   @map("guest_session_id") @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  documentVersion String   @map("document_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  @@index([guestSessionId, eventId])
  @@map("guest_consent_record")
}

model UploadAttempt {
  id                  String    @id @db.Uuid
  eventId             String    @map("event_id") @db.Uuid
  guestSessionId      String    @map("guest_session_id") @db.Uuid
  reservationId       String    @map("reservation_id") @db.Uuid
  idempotencyKey      String    @map("idempotency_key")
  declaredSize        BigInt    @map("declared_size")
  declaredType        String    @map("declared_type")
  contributorNickname String    @map("contributor_nickname")
  status              String    @default("AUTHORIZED")
  objectKey           String?   @map("object_key")
  actualSize          BigInt?   @map("actual_size")
  detectedType        String?   @map("detected_type")
  durationSeconds     Decimal?  @map("duration_seconds")
  rejectionReason     String?   @map("rejection_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([eventId, idempotencyKey])
  @@index([eventId, status])
  @@index([guestSessionId])
  @@map("upload_attempt")
}

