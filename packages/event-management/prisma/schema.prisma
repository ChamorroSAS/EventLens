datasource db {
  provider = "postgresql"
}

model Event {
  id                     String   @id @db.Uuid
  organizerId            String   @map("organizer_id") @db.Uuid
  name                   String
  status                 String   @default("DRAFT")
  timezone               String    @default("America/Bogota")
  startsAtLocal          String?   @map("starts_at_local")
  scheduledAt            DateTime? @map("scheduled_at") @db.Timestamptz
  utcOffsetMinutes       Int?      @map("utc_offset_minutes")
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz
  graceEndsAt            DateTime? @map("grace_ends_at") @db.Timestamptz
  activatedAt            DateTime? @map("activated_at") @db.Timestamptz
  closedAt               DateTime? @map("closed_at") @db.Timestamptz
  purgeStartedAt         DateTime? @map("purge_started_at") @db.Timestamptz
  suspendedAt            DateTime? @map("suspended_at") @db.Timestamptz
  suspensionReason       String?   @map("suspension_reason")
  previousStatus         String?   @map("previous_status")
  validityDurationDays   Int?      @map("validity_duration_days")
  graceDays              Int?      @map("grace_days")
  uploadsEnabled         Boolean   @default(false) @map("uploads_enabled")
  guestGalleryEnabled    Boolean  @default(false) @map("guest_gallery_enabled")
  moderationMode         String   @default("AUTO_PUBLISH") @map("moderation_mode")
  pinEnabled             Boolean  @default(false) @map("pin_enabled")
  pinHash                String?  @map("pin_hash")
  pinSalt                String?  @map("pin_salt")
  idempotencyKey         String?  @unique @map("idempotency_key")
  idempotencyPayloadHash String?  @map("idempotency_payload_hash")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizerId, status])
  @@map("event")
}
