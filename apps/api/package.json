{
    "name":  "@eventlens/api",
    "version":  "0.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run --exclude \"test/integration/**\"",
                    "test:integration":  "pnpm build \u0026\u0026 vitest run test/integration",
                    "start":  "node dist/main.js",
                    "openapi:export":  "pnpm build \u0026\u0026 node dist/export-openapi.js"
                },
    "dependencies":  {
                         "@eventlens/admin-support": "workspace:*",
                         "@eventlens/database":  "workspace:*",
                         "@eventlens/event-management":  "workspace:*",
                         "@eventlens/identity":  "workspace:*",
                         "@nestjs/common":  "12.1.2",
                         "@nestjs/core":  "12.1.2",
                         "@nestjs/platform-express":  "12.1.2",
                         "@nestjs/swagger":  "12.0.2",
                         "reflect-metadata":  "0.2.2",
                         "rxjs":  "7.8.2"
                     },
    "devDependencies":  {
                            "@nestjs/testing":  "12.1.2",
                            "@types/node":  "24.10.1",
                            "typescript":  "5.9.3",
                            "vitest":  "4.0.18"
                        }
}
