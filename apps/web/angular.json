{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "web": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "index": "src/index.html",
            "tsConfig": "tsconfig.app.json", "outputPath": "dist/web",
            "assets": [
              { "glob": "**/*", "input": "public" }
            ],
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": { "includePaths": ["src/styles"] },
            "styles": [
              "src/styles/styles.scss"
            ]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" }] },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "web:build:development", "proxyConfig": "proxy.conf.cjs", "allowedHosts": ["web"] }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "tsConfig": "tsconfig.spec.json", "runner": "vitest" }
        }
      }
    }
  }
}
