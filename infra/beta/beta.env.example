# Phoeve Beta — environment contract (Etapa 1)
#
# This file is the documentation of record for the variables the Beta stack
# consumes, and the input used to statically validate the Compose contract:
#
#   node infra/beta/preflight.mjs --env-file infra/beta/beta.env.example
#
# It is NOT a deployable file: the two secret values below are placeholders and
# the preflight rejects anything that still looks like a placeholder. On the host
# the real file is rendered at /srv/phoeve/beta/app.env with mode 0600 by
# infra/beta/deploy/render-env.sh, which reads the secrets from SSM SecureString.
#
# Nothing here enables a blocked capability. There is no variable that turns on
# organizer login, event creation, media reception or local admin access.

# --- Images ---------------------------------------------------------------
# Pinned by digest before every deployment. Tag-only references are accepted for
# local validation but must not be used on the host (see deploy/deploy.sh).
PHOEVE_API_IMAGE=REPLACE_WITH_DIGEST_PINNED_API_IMAGE
PHOEVE_WEB_IMAGE=REPLACE_WITH_DIGEST_PINNED_WEB_IMAGE
PHOEVE_EDGE_IMAGE=caddy:2.10.0-alpine
PHOEVE_POSTGRES_IMAGE=postgres:16.15-alpine3.24

# --- Data location --------------------------------------------------------
# Mount points backed by dedicated EBS volumes (see infra/terraform).
PHOEVE_DATA_ROOT=/srv/phoeve/beta

# --- Published surface ----------------------------------------------------
# Public entry base URL. Guest links and QR payloads are derived from it.
PUBLIC_ENTRY_BASE_URL=https://beta.phoeve.com
# Edge site address handed to Caddy. In production this is the bare host name and
# ACME issues the certificate; locally it may be http://localhost for validation.
PHOEVE_SITE_ADDRESS=beta.phoeve.com
# Real mailbox for certificate expiry notices.
ACME_EMAIL=REPLACE_WITH_OPERATOR_MAILBOX

# --- Edge binding ---------------------------------------------------------
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# --- Database -------------------------------------------------------------
POSTGRES_USER=phoeve
POSTGRES_DB=phoeve
# Injected from SSM SecureString by deploy/render-env.sh.
POSTGRES_PASSWORD=REPLACE_WITH_SSM_SECURE_STRING

# --- Application secrets --------------------------------------------------
# Injected from SSM SecureString by deploy/render-env.sh. Must be at least 32
# characters and must not be the development default: the preflight enforces it.
IDENTITY_PEPPER_SECRET=REPLACE_WITH_SSM_SECURE_STRING

# --- Resource limits ------------------------------------------------------
POSTGRES_MEM_LIMIT=1g
API_MEM_LIMIT=1g
