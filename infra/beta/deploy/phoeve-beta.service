[Unit]
Description=Phoeve Beta stack (Compose)
Documentation=https://github.com/ (docs/aws-preview-deployment.md)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# The stack must never start without its data volume.
RequiresMountsFor=/srv/phoeve/beta/postgres

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/phoeve/beta/current
EnvironmentFile=/etc/phoeve/beta-volumes.env
ExecStartPre=/usr/local/sbin/phoeve-mount-guard --from-env /etc/phoeve/beta-volumes.env
ExecStartPre=/usr/bin/test -f /srv/phoeve/beta/app.env
ExecStartPre=/usr/bin/test -f /srv/phoeve/beta/current/compose.yaml
ExecStart=/usr/bin/docker compose --env-file /srv/phoeve/beta/app.env --project-directory /srv/phoeve/beta/current -f /srv/phoeve/beta/current/compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /srv/phoeve/beta/app.env --project-directory /srv/phoeve/beta/current -f /srv/phoeve/beta/current/compose.yaml down
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
