{
  "Statement": [
    {
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy",
        "iam:PassRole",
        "route53:ChangeResourceRecordSets",
        "route53:GetChange",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ec2:AllocateAddress",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet",
        "ec2:CreateVolume",
        "ec2:CreateVpc",
        "ec2:AssociateAddress",
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:AttachVolume",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateRoute",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteRoute",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVolume",
        "ec2:DeleteVpc",
        "ec2:DetachInternetGateway",
        "ec2:DetachVolume",
        "ec2:DisassociateAddress",
        "ec2:DisassociateRouteTable",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVolume",
        "ec2:ModifyVpcAttribute",
        "ec2:ReleaseAddress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagLogGroup",
        "logs:ListTagsLogGroup",
        "logs:TagResource",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource",
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:ListTagsForResource",
        "dlm:CreateLifecyclePolicy",
        "dlm:DeleteLifecyclePolicy",
        "dlm:GetLifecyclePolicy",
        "dlm:UpdateLifecyclePolicy",
        "dlm:TagResource",
        "budgets:ModifyBudget",
        "budgets:ViewBudget",
        "ec2:Describe*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DescribeParameters",
        "iam:GetPolicyVersion",
        "iam:ListInstanceProfilesForRole",
        "logs:DescribeLogGroups",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "tag:GetResources",
        "sts:GetCallerIdentity",
        "ssm:SendCommand",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands"
      ],
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy",
        "iam:PassRole"
      ],
      "Effect": "Deny",
      "NotResource": [
        "arn:aws:iam::123456789012:role/phoeve-beta-instance",
        "arn:aws:iam::123456789012:instance-profile/phoeve-beta-instance",
        "arn:aws:iam::123456789012:policy/phoeve-beta-instance-runtime"
      ],
      "Sid": "ProtectAllNonWorkloadIdentity"
    },
    {
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "NeverRemoveOrReplaceBoundaries"
    },
    {
      "Action": [
        "iam:CreateRole"
      ],
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::123456789012:policy/phoeve-beta-workload-boundary"
        }
      },
      "Effect": "Deny",
      "Resource": "arn:aws:iam::123456789012:role/phoeve-beta-instance"
    },
    {
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Condition": {
        "ArnNotEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::123456789012:policy/phoeve-beta-instance-runtime",
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": "arn:aws:iam::123456789012:role/phoeve-beta-instance"
    },
    {
      "Action": [
        "iam:PassRole"
      ],
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      },
      "Effect": "Deny",
      "Resource": "arn:aws:iam::123456789012:role/phoeve-beta-instance"
    },
    {
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Effect": "Deny",
      "NotResource": "arn:aws:route53:::hostedzone/ZTESTBETA"
    },
    {
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Condition": {
        "ForAnyValue:StringNotEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "beta.phoeve.com"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": "*"
    },
    {
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Condition": {
        "ForAnyValue:StringNotEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "A"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": "*"
    },
    {
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Effect": "Deny",
      "NotResource": [
        "arn:aws:ssm:us-east-1:123456789012:parameter/phoeve/beta",
        "arn:aws:ssm:us-east-1:123456789012:parameter/phoeve/beta/*"
      ]
    },
    {
      "Action": [
        "ec2:*"
      ],
      "Condition": {
        "StringNotEquals": {
          "ec2:Region": "us-east-1"
        }
      },
      "Effect": "Deny",
      "Resource": "*"
    }
  ],
  "Version": "2012-10-17"
}
